# Copy this file to .env.local and fill in real values.

# Postgres database URL. Required.
# Free options: Neon (https://neon.tech), Supabase, or Render Postgres.
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# NextAuth — the URL your app is served from + a random secret for JWT signing.
# Generate a secret with:  openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-long-random-string

# OpenRouter — used by /api/generate to call free LLMs for new video generation.
# Get a free key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key


# Azure AI Speech — narration voices for explainer videos (optional; without it
# the player uses the browser's built-in voices). Free tier: 0.5M chars/month.
# Create a "Speech" resource at https://portal.azure.com and copy Key 1 + Region.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=centralindia

# Free narration voices: AI4Bharat Indic Parler-TTS via its Hugging Face Space.
# Optional token = your account's own ZeroGPU quota (https://huggingface.co/settings/tokens, "Read" is enough).
HF_TOKEN=
