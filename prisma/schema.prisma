generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── NextAuth core models ─────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ── User & profile ───────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())

  // grade / language defaults — set in onboarding
  preferredLanguage String?  @default("Hindi")
  preferredGrade    String?  @default("9-10")

  // "STUDENT" | "TEACHER" — picked on the login screen
  role String @default("STUDENT")

  // scrypt hash (see src/lib/password.ts); null for accounts created before passwords
  passwordHash String?

  accounts   Account[]
  sessions   Session[]
  videos     Video[]
  watches    Watch[]
  downloads  Download[]
  bookmarks  Bookmark[]
  ratings    Rating[]
  comments   Comment[]
  playlists  Playlist[]
  streak     Streak?

  teacherDocs    TeacherDoc[]
  classesTaught  Classroom[]
  classMembers   ClassMember[]
  quizAttempts   QuizAttempt[]

  studentDocs StudentDoc[]
  xpEvents    XpEvent[]
}

// ── Domain models ────────────────────────────────────────────────────

model Video {
  id         String   @id @default(cuid())
  topic      String
  language   String
  grade      String
  voiceType  String
  videoStyle String
  script     String   // JSON-stringified ScriptLine[]
  manimCode  String
  scene      String?  // JSON-stringified Scene (title, duration, steps)
  duration   Int?     // seconds
  subject    String?  // auto-inferred (Math/Physics/etc)
  createdAt  DateTime @default(now())

  userId  String
  user    User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  watches        Watch[]
  downloads      Download[]
  bookmarks      Bookmark[]
  ratings        Rating[]
  comments       Comment[]
  playlistItems  PlaylistItem[]
}

model Watch {
  id        String   @id @default(cuid())
  userId    String
  videoId   String
  watchedAt DateTime @default(now())
  duration  Int      @default(0)  // seconds watched
  completed Boolean  @default(false)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([userId, watchedAt])
}

model Download {
  id           String   @id @default(cuid())
  userId       String
  videoId      String
  downloadedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([userId, downloadedAt])
}

model Bookmark {
  id         String   @id @default(cuid())
  userId     String
  videoId    String?
  topic      String?  // bookmark by topic name even if no video exists yet
  subject    String?
  createdAt  DateTime @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  video Video? @relation(fields: [videoId], references: [id], onDelete: SetNull)
}

model Streak {
  id           String   @id @default(cuid())
  userId       String   @unique
  current      Int      @default(0)
  longest      Int      @default(0)
  lastActiveAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ── Engagement models ────────────────────────────────────────────────

model Rating {
  id        String   @id @default(cuid())
  userId    String
  videoId   String
  value     Int      // 1–5 stars
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([userId, videoId])  // one rating per user per video
  @@index([videoId])
}

model Comment {
  id        String   @id @default(cuid())
  userId    String
  videoId   String
  text      String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([videoId, createdAt])
}

model Playlist {
  id        String   @id @default(cuid())
  userId    String
  title     String
  emoji     String?  @default("📚")
  createdAt DateTime @default(now())

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items PlaylistItem[]

  @@index([userId])
}

model PlaylistItem {
  id         String   @id @default(cuid())
  playlistId String
  videoId    String
  order      Int      @default(0)
  addedAt    DateTime @default(now())

  playlist Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  video    Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([playlistId, videoId])
}

// ── Teacher workspace ────────────────────────────────────────────────

// AI-generated, teacher-editable material: slide decks, quizzes, lesson plans
// and toolkit outputs. `content` is JSON whose shape depends on `type`.
model TeacherDoc {
  id        String   @id @default(cuid())
  userId    String
  type      String   // "slides" | "quiz" | "lesson" | "toolkit"
  title     String
  topic     String
  grade     String
  language  String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignments Assignment[]

  @@index([userId, type])
}

model Classroom {
  id        String   @id @default(cuid())
  teacherId String
  name      String
  subject   String?
  grade     String?
  joinCode  String   @unique
  createdAt DateTime @default(now())

  teacher     User          @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  members     ClassMember[]
  assignments Assignment[]
}

model ClassMember {
  id          String   @id @default(cuid())
  classroomId String
  userId      String
  joinedAt    DateTime @default(now())

  classroom Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([classroomId, userId])
}

// Something a teacher shares with a class: a quiz/slides/lesson doc or a library video.
model Assignment {
  id          String    @id @default(cuid())
  classroomId String
  kind        String    // "quiz" | "slides" | "lesson" | "video"
  title       String
  docId       String?
  videoId     String?
  dueAt       DateTime?
  createdAt   DateTime  @default(now())

  classroom Classroom     @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  doc       TeacherDoc?   @relation(fields: [docId], references: [id], onDelete: Cascade)
  attempts  QuizAttempt[]
}

model QuizAttempt {
  id           String   @id @default(cuid())
  assignmentId String
  userId       String
  answers      String   // JSON array of chosen option indexes
  score        Int
  total        Int
  createdAt    DateTime @default(now())

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, userId])
}

// ── Student study tools ──────────────────────────────────────────────

// A student's own study material: flashcard decks, revision notes, mock tests,
// study plans and solved doubts. `content` is JSON whose shape depends on `type`.
model StudentDoc {
  id        String   @id @default(cuid())
  userId    String
  type      String   // "flashcards" | "notes" | "mock" | "plan" | "doubt"
  title     String
  topic     String
  grade     String
  language  String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

// One XP award (see src/lib/xp.ts). `refId` makes repeatable actions idempotent.
model XpEvent {
  id        String   @id @default(cuid())
  userId    String
  kind      String
  points    Int
  refId     String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, kind, refId])
}
